datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ReservationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  FULFILLED
}

model Reservation {
  id              Int               @id @default(autoincrement())
  equipmentId     Int
  studentId       Int
  studentEmail    String
  studentName     String?           // nombre del que reserva (si viene en JWT)
  technicianName  String?           // se llena al aprobar
  startAt         DateTime
  endAt           DateTime
  reason          String?
  status          ReservationStatus  @default(PENDING)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([equipmentId])
  @@index([studentId])
  @@index([status])
}

model EquipmentSnapshot {
  equipmentId Int @id
  name        String
  status      String
  createdAt   DateTime @default(now())
}
