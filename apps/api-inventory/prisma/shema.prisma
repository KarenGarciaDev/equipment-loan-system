datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum EquipmentStatus {
  AVAILABLE
  RESERVED
  LOANED
  MAINTENANCE
}

model Equipment {
  id          Int            @id @default(autoincrement())
  code        String         @unique
  name        String
  description String?
  status      EquipmentStatus @default(AVAILABLE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}
